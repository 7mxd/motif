{
  "$extensions": {
    "dev.motif": {
      "motifContract": 1,
      "preset": "editorial",
      "pairs": [
        {
          "fg": "color.text-primary",
          "bg": "color.background",
          "kind": "text"
        },
        {
          "fg": "color.text-primary",
          "bg": "color.surface",
          "kind": "text"
        },
        {
          "fg": "color.text-primary",
          "bg": "color.surface-raised",
          "kind": "text"
        },
        {
          "fg": "color.text-secondary",
          "bg": "color.background",
          "kind": "text"
        },
        {
          "fg": "color.text-secondary",
          "bg": "color.surface",
          "kind": "text"
        },
        {
          "fg": "color.text-secondary",
          "bg": "color.surface-raised",
          "kind": "text"
        },
        {
          "fg": "color.on-action-primary",
          "bg": "color.action-primary",
          "kind": "text"
        },
        {
          "fg": "color.on-action-secondary",
          "bg": "color.action-secondary",
          "kind": "text"
        },
        {
          "fg": "color.on-success",
          "bg": "color.success",
          "kind": "text"
        },
        {
          "fg": "color.on-warning",
          "bg": "color.warning",
          "kind": "text"
        },
        {
          "fg": "color.on-danger",
          "bg": "color.danger",
          "kind": "text"
        },
        {
          "fg": "color.on-info",
          "bg": "color.info",
          "kind": "text"
        },
        {
          "fg": "color.focus",
          "bg": "color.background",
          "kind": "ui"
        }
      ]
    }
  },
  "primitive": {
