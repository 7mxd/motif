#!/bin/sh
# Motif bootstrap: runs the Motif tool that matches this skill's VERSION,
# downloading and verifying it once if it isn't cached yet.
set -eu

SKILL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VERSION=$(tr -d ' \r\n' < "$SKILL_DIR/VERSION")

if [ -n "${MOTIF_BIN:-}" ]; then
  exec "$MOTIF_BIN" "$@"
fi

REPO="${MOTIF_REPO:-7mxd/motif}"
case "$(uname -s)" in
  Darwin) OS=darwin ;;
  Linux) OS=linux ;;
  MINGW*|MSYS*|CYGWIN*) OS=windows ;;
  *) echo "Motif: this operating system ($(uname -s)) isn't supported yet." >&2; exit 2 ;;
esac
case "$(uname -m)" in
  x86_64|amd64) ARCH=x64 ;;
  arm64|aarch64) ARCH=arm64 ;;
  *) echo "Motif: this processor type ($(uname -m)) isn't supported yet." >&2; exit 2 ;;
esac
EXT=""
if [ "$OS" = windows ]; then EXT=".exe"; ARCH=x64; fi

ASSET="motif-$OS-$ARCH$EXT"
CACHE_DIR="${MOTIF_HOME:-$HOME/.motif}/bin/$VERSION"
BIN="$CACHE_DIR/motif$EXT"

fetch() {
  # A connection that stalls (under 1 KB/s for a minute) gives up instead of hanging an agent's tool call.
  if command -v curl >/dev/null 2>&1; then curl -fsSL --connect-timeout 20 --speed-limit 1024 --speed-time 60 "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -q -T 60 "$1" -O "$2"
  else return 1
  fi
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1
  else shasum -a 256 "$1" | cut -d ' ' -f 1
  fi
}

if [ ! -x "$BIN" ]; then
  BASE="${MOTIF_DOWNLOAD_BASE:-https://github.com/$REPO/releases/download/v$VERSION}"
  TMP=$(mktemp -d)
  trap 'rm -rf "$TMP"' EXIT
  echo "Motif: downloading the Motif tool v$VERSION (one time only)..." >&2
  if ! fetch "$BASE/$ASSET" "$TMP/$ASSET" || ! fetch "$BASE/SHA256SUMS" "$TMP/SHA256SUMS"; then
    echo "Motif: couldn't download the Motif tool. Check your internet connection and try again." >&2
    exit 2
  fi
  # "hash  name" or, from sha256sum --binary, "hash *name".
  EXPECTED=$(awk -v a="$ASSET" '{ sub(/\r$/, ""); n = $2; sub(/^\*/, "", n); if (n == a) { print tolower($1); exit } }' "$TMP/SHA256SUMS")
  ACTUAL=$(sha256 "$TMP/$ASSET")
  if [ -z "$EXPECTED" ] || [ "$EXPECTED" != "$ACTUAL" ]; then
    echo "Motif: the downloaded tool failed its safety check, so it wasn't used. Please try again later, or report this at https://github.com/$REPO/issues" >&2
    echo "Motif: SHA-256 expected ${EXPECTED:-none}, got ${ACTUAL:-none}." >&2
    exit 2
  fi
  install_failed() {
    echo "Motif: couldn't set up the Motif tool in $CACHE_DIR. Check that this folder is writable and try again." >&2
    exit 2
  }
  mkdir -p "$CACHE_DIR" || install_failed
  # A unique name per process: agents often run several tool calls at once, so first runs can overlap.
  PARTIAL=$(mktemp "$CACHE_DIR/.motif.XXXXXX") || install_failed
  mv -f "$TMP/$ASSET" "$PARTIAL" || install_failed
  chmod +x "$PARTIAL"
  # If another run finished first (or its binary is busy on Windows), keep that one.
  if [ -x "$BIN" ] || ! mv -f "$PARTIAL" "$BIN" 2>/dev/null; then
    rm -f "$PARTIAL"
    [ -x "$BIN" ] || install_failed
  fi
  rm -rf "$TMP"
  trap - EXIT
fi

exec "$BIN" "$@"
