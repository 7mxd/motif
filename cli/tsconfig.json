  "include": ["src", "test"],
  "exclude": ["test/fixtures/expo-min", "test/fixtures/vue-min", "test/fixtures/nuxt-min", "test/fixtures/svelte-min", "test/fixtures/svelte-vite-min", "test/fixtures/kit3-min", "test/fixtures/angular-min", "test/fixtures/ng22-min", "test/fixtures/expo-audit-routes", "test/fixtures/rn-palettes", "node_modules"]
}
