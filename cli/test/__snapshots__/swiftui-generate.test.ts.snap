"// Generated by Motif — edit design/tokens.json instead, then run "motif tokens".

import SwiftUI

/// The guide's colour roles, light and dark.
///
/// Read them in a view with @Environment(\\.motifColors) private var colors.
struct MotifColors: Equatable, Sendable {
