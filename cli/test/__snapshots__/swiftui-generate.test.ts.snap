        success: Color(.sRGB, red: 0.0824, green: 0.502, blue: 0.2392, opacity: 1),
        onSuccess: Color(.sRGB, red: 1, green: 1, blue: 1, opacity: 1),
        warning: Color(.sRGB, red: 0.7059, green: 0.3255, blue: 0.0353, opacity: 1),
        onWarning: Color(.sRGB, red: 1, green: 1, blue: 1, opacity: 1),
        danger: Color(.sRGB, red: 0.7255, green: 0.1098, blue: 0.1098, opacity: 1),
        onDanger: Color(.sRGB, red: 1, green: 1, blue: 1, opacity: 1),
        info: Color(.sRGB, red: 0.1137, green: 0.3059, blue: 0.8471, opacity: 1),
        onInfo: Color(.sRGB, red: 1, green: 1, blue: 1, opacity: 1)
    )

    /// Dark mode.
    static let dark = MotifColors(
        background: Color(.sRGB, red: 0.0118, green: 0.0275, blue: 0.0706, opacity: 1),
        surface: Color(.sRGB, red: 0.0667, green: 0.0941, blue: 0.1529, opacity: 1),
        surfaceRaised: Color(.sRGB, red: 0.1216, green: 0.1608, blue: 0.2157, opacity: 1),
        border: Color(.sRGB, red: 0.2157, green: 0.2549, blue: 0.3176, opacity: 1),
        textPrimary: Color(.sRGB, red: 0.9765, green: 0.9804, blue: 0.9843, opacity: 1),
        textSecondary: Color(.sRGB, red: 0.6118, green: 0.6392, blue: 0.6863, opacity: 1),
        textInverse: Color(.sRGB, red: 0.0667, green: 0.0941, blue: 0.1529, opacity: 1),
        actionPrimary: Color(.sRGB, red: 0.5059, green: 0.549, blue: 0.9725, opacity: 1),
        onActionPrimary: Color(.sRGB, red: 0.0667, green: 0.0941, blue: 0.1529, opacity: 1),
        actionSecondary: Color(.sRGB, red: 0.2157, green: 0.2549, blue: 0.3176, opacity: 1),
        onActionSecondary: Color(.sRGB, red: 0.9765, green: 0.9804, blue: 0.9843, opacity: 1),
