        onActionPrimary: Color(.sRGB, red: 0.0667, green: 0.0941, blue: 0.1529, opacity: 1),
        actionSecondary: Color(.sRGB, red: 0.2157, green: 0.2549, blue: 0.3176, opacity: 1),
        onActionSecondary: Color(.sRGB, red: 0.9765, green: 0.9804, blue: 0.9843, opacity: 1),
        focus: Color(.sRGB, red: 0.5059, green: 0.549, blue: 0.9725, opacity: 1),
        success: Color(.sRGB, red: 0.2902, green: 0.8706, blue: 0.502, opacity: 1),
        onSuccess: Color(.sRGB, red: 0.0667, green: 0.0941, blue: 0.1529, opacity: 1),
        warning: Color(.sRGB, red: 0.9843, green: 0.749, blue: 0.1412, opacity: 1),
        onWarning: Color(.sRGB, red: 0.0667, green: 0.0941, blue: 0.1529, opacity: 1),
        danger: Color(.sRGB, red: 0.9725, green: 0.4431, blue: 0.4431, opacity: 1),
        onDanger: Color(.sRGB, red: 0.0667, green: 0.0941, blue: 0.1529, opacity: 1),
        info: Color(.sRGB, red: 0.3765, green: 0.6471, blue: 0.9804, opacity: 1),
        onInfo: Color(.sRGB, red: 0.0667, green: 0.0941, blue: 0.1529, opacity: 1)
    )

    /// The colours for a colour scheme and a design variant.
    static func resolve(_ scheme: ColorScheme, variant: MotifVariant = .defaultVariant) -> MotifColors {
        switch variant {
        case .defaultVariant: return scheme == .dark ? dark : light
        case .partner: return scheme == .dark ? partnerDark : partnerLight
        }
    }
}

extension EnvironmentValues {
    /// The design variant .motifTheme(variant:) chose.
    @Entry var motifVariant: MotifVariant = .defaultVariant

    /// The guide's colours for the colour scheme and the design variant here.
    var motifColors: MotifColors { MotifColors.resolve(colorScheme, variant: motifVariant) }
}

/// The theme's settings.
enum MotifTheme {
    /// Set by Motif's screenshots. Leave it nil in your app.
    @MainActor static var debugVariantOverride: MotifVariant?
}

extension View {
    /// The guide's theme for this view and the views inside it: the design variant and the accent colour (tint).
    /// Apply it to your root view, in your App's WindowGroup.
    func motifTheme(variant: MotifVariant = .defaultVariant) -> some View {
        modifier(MotifThemeModifier(variant: variant))
    }
}

private struct MotifThemeModifier: ViewModifier {
    let variant: MotifVariant
    @Environment(\\.colorScheme) private var scheme

    func body(content: Content) -> some View {
        let chosen = MotifTheme.debugVariantOverride ?? variant
        return content
            .environment(\\.motifVariant, chosen)
            .tint(MotifColors.resolve(scheme, variant: chosen).actionPrimary)
    }
}

/// Spacing, in points.
enum MotifSpace {
    static let s0: CGFloat = 0
    static let s1: CGFloat = 4
    static let s2: CGFloat = 8
    static let s3: CGFloat = 12
    static let s4: CGFloat = 16
    static let s5: CGFloat = 20
    static let s6: CGFloat = 24
    static let s8: CGFloat = 32
    static let s10: CGFloat = 40
    static let s12: CGFloat = 48
    static let s16: CGFloat = 64
}

/// Corner radii, in points.
enum MotifRadius {
    static let none: CGFloat = 0
    static let sm: CGFloat = 4
    static let md: CGFloat = 8
    static let lg: CGFloat = 16
    static let full: CGFloat = 9999
}

/// One layer of a shadow. The radius is half the CSS blur, as SwiftUI blurs it.
struct MotifShadow: Sendable {
    let color: Color
    let radius: CGFloat
    let x: CGFloat
    let y: CGFloat
}

/// Shadows, for .motifShadow(MotifShadows.md). Inset layers and spread are left out.
enum MotifShadows {
    static let sm: [MotifShadow] = [
        MotifShadow(color: Color(.sRGB, red: 0, green: 0, blue: 0, opacity: 0.08), radius: 1, x: 0, y: 1),
    ]
    static let md: [MotifShadow] = [
        MotifShadow(color: Color(.sRGB, red: 0, green: 0, blue: 0, opacity: 0.1), radius: 6, x: 0, y: 4),
    ]
    static let lg: [MotifShadow] = [
        MotifShadow(color: Color(.sRGB, red: 0, green: 0, blue: 0, opacity: 0.14), radius: 16, x: 0, y: 12),
    ]
}

extension View {
    /// Draws the shadow's layers around the view in CSS's order, the first on top. SwiftUI shadows the view with
    /// the earlier layers' shadows in it, so each later layer also casts the earlier ones: they compound a little.
    func motifShadow(_ layers: [MotifShadow]) -> some View {
        layers.reduce(AnyView(self)) { view, layer in
            AnyView(view.shadow(color: layer.color, radius: layer.radius, x: layer.x, y: layer.y))
        }
    }
}

/// Durations, in seconds.
enum MotifDurations {
    static let instant: Double = 0
    static let fast: Double = 0.12
    static let base: Double = 0.2
    static let slow: Double = 0.32
}

/// Easing curves, for withAnimation(MotifCurves.standard), over the base duration.
/// Over another: MotifCurves.standard(over: MotifDurations.slow).
enum MotifCurves {
    static let standard = Animation.timingCurve(0.2, 0, 0, 1, duration: MotifDurations.base)
    /// The standard curve over another duration.
    static func standard(over duration: Double) -> Animation {
        Animation.timingCurve(0.2, 0, 0, 1, duration: duration)
    }

    static let enter = Animation.timingCurve(0, 0, 0, 1, duration: MotifDurations.base)
    /// The enter curve over another duration.
    static func enter(over duration: Double) -> Animation {
        Animation.timingCurve(0, 0, 0, 1, duration: duration)
    }

    static let exit = Animation.timingCurve(0.3, 0, 1, 1, duration: MotifDurations.base)
    /// The exit curve over another duration.
    static func exit(over duration: Double) -> Animation {
        Animation.timingCurve(0.3, 0, 1, 1, duration: duration)
    }
}

/// Springs, for withAnimation(MotifSprings.snappy): the guide's own duration and bounce.
enum MotifSprings {
    static let snappy = Animation.spring(duration: 0.25, bounce: 0)
    static let smooth = Animation.spring(duration: 0.4, bounce: 0.1)
    static let bouncy = Animation.spring(duration: 0.5, bounce: 0.3)
}

/// Reduced motion. Read the setting in a view, and pass it with each animation:
///
///     @Environment(\\.accessibilityReduceMotion) private var reduceMotion
///     withAnimation(MotifMotion.animation(MotifSprings.snappy, reduceMotion: reduceMotion)) { … }
enum MotifMotion {
    /// The animation, or none when the person asks for less motion.
    static func animation(_ animation: Animation, reduceMotion: Bool) -> Animation? {
        reduceMotion ? nil : animation
    }
}

/// A type role: its font, its line height and its letter spacing. It carries no colour, so the view's foreground
/// style applies.
///
/// Use it with .motifFont(.body), which sets all three. .motifFont(.body) scales every role with Dynamic Type
/// (relative to the role's text style), the system font's too, with its line spacing and letter spacing; the line
/// spacing comes from the font's own line height (1.2 times the size when the font can't be loaded).
/// Where a Font is needed: MotifType.body.font(), which sets neither spacing.
/// MotifType.body.font() alone scales a role in a named font, not one in the system font: prefer .motifFont.
/// A role with an Arabic companion uses it when the layout is right to left or the language is written in Arabic script.
struct MotifType: Sendable {
    /// The size in points, before Dynamic Type.
    let size: CGFloat
    /// The guide's line height, as a multiple of the size.
    let lineHeight: CGFloat
    /// Letter spacing in points, before Dynamic Type.
    let tracking: CGFloat
    let weight: Font.Weight
    /// The Dynamic Type text style the role scales with.
    let textStyle: Font.TextStyle
    /// The font's family, or nil for the system font in its design.
    let family: String?
    let design: Font.Design
    /// The Arabic companion's family, when the role has one.
    let arabicFamily: String?

    /// The role's font at its own size, or its Arabic companion's (the role's own font when it has none). A named font
    /// scales with Dynamic Type by itself; the system font keeps its size: use .motifFont for that.
    func font(arabic useArabic: Bool = false) -> Font {
        if let name = useArabic ? (arabicFamily ?? family) : family {
            return Font.custom(name, size: size, relativeTo: textStyle).weight(weight)
        }
        return Font.system(size: size, weight: weight, design: design)
    }

    /// The role's font at a size Dynamic Type has already scaled, as .motifFont gives it.
    func font(size: CGFloat, arabic useArabic: Bool = false) -> Font {
        if let name = useArabic ? (arabicFamily ?? family) : family {
            return Font.custom(name, fixedSize: size).weight(weight)
        }
        return Font.system(size: size, weight: weight, design: design)
    }

    /// Letter spacing at a scaled size.
    func tracking(size: CGFloat) -> CGFloat {
        tracking * size / max(self.size, 1)
    }

    /// The space between lines at a scaled size: the guide's line height less the font's own, read from the font
    /// (1.2 times the size when it can't be loaded).
    func lineSpacing(size: CGFloat, arabic useArabic: Bool = false) -> CGFloat {
        max(0, lineHeight * size - (naturalLineHeight(size: size, arabic: useArabic) ?? 1.2 * size))
    }

    /// The font's own line height at a size (its ascender, descender and leading), or nil when it can't be loaded.
    func naturalLineHeight(size: CGFloat, arabic useArabic: Bool = false) -> CGFloat? {
        let name = useArabic ? (arabicFamily ?? family) : family
        #if canImport(UIKit)
        if let name {
            if let font = UIFont(name: name, size: size) { return font.lineHeight }
            let font = UIFont(descriptor: UIFontDescriptor(fontAttributes: [.family: name]), size: size)
            return font.familyName.caseInsensitiveCompare(name) == .orderedSame ? font.lineHeight : nil
        }
        let system = UIFont.systemFont(ofSize: size)
        return (system.fontDescriptor.withDesign(systemDesign).map { UIFont(descriptor: $0, size: size) } ?? system).lineHeight
        #elseif canImport(AppKit)
        let font: NSFont?
        if let name {
            let byFamily = NSFont(descriptor: NSFontDescriptor(fontAttributes: [.family: name]), size: size)
            font = NSFont(name: name, size: size) ?? (byFamily?.familyName?.caseInsensitiveCompare(name) == .orderedSame ? byFamily : nil)
        } else {
            let system = NSFont.systemFont(ofSize: size)
            font = system.fontDescriptor.withDesign(systemDesign).flatMap { NSFont(descriptor: $0, size: size) } ?? system
        }
        guard let font else { return nil }
        return font.ascender - font.descender + font.leading
        #else
        return nil
        #endif
    }

    #if canImport(UIKit)
    private var systemDesign: UIFontDescriptor.SystemDesign {
        design == .serif ? .serif : design == .rounded ? .rounded : design == .monospaced ? .monospaced : .default
    }
    #elseif canImport(AppKit)
    private var systemDesign: NSFontDescriptor.SystemDesign {
        design == .serif ? .serif : design == .rounded ? .rounded : design == .monospaced ? .monospaced : .default
    }
    #endif

    /// Languages written in Arabic script: their text takes the Arabic companion.
    private static let arabicScript: Set<String> = ["ar", "fa", "ur", "ps", "ckb", "sd", "ug"]

    /// True when the locale's language is written in Arabic script.
    static func isArabic(_ locale: Locale) -> Bool {
        arabicScript.contains(locale.language.languageCode?.identifier ?? "")
    }

    static let display = MotifType(
        size: 40,
        lineHeight: 1.1,
        tracking: 0,
        weight: .bold,
        textStyle: .largeTitle,
        family: "Inter",
        design: .default,
        arabicFamily: nil
    )

    static let title = MotifType(
        size: 28,
        lineHeight: 1.2,
        tracking: 0,
        weight: .bold,
        textStyle: .title,
        family: "Inter",
        design: .default,
        arabicFamily: nil
    )

    static let heading = MotifType(
        size: 20,
        lineHeight: 1.3,
        tracking: 0,
        weight: .semibold,
        textStyle: .title3,
        family: "Inter",
        design: .default,
        arabicFamily: nil
    )

    static let body = MotifType(
        size: 16,
        lineHeight: 1.5,
        tracking: 0,
        weight: .regular,
        textStyle: .callout,
        family: "Onest",
        design: .default,
        arabicFamily: "Readex Pro"
    )

    static let label = MotifType(
        size: 14,
        lineHeight: 1.4,
        tracking: 0,
        weight: .medium,
        textStyle: .subheadline,
        family: "Inter",
        design: .default,
        arabicFamily: nil
    )

    static let caption = MotifType(
        size: 12,
        lineHeight: 1.4,
        tracking: 0,
        weight: .regular,
        textStyle: .caption,
        family: "Inter",
        design: .default,
        arabicFamily: nil
    )
}

extension View {
    /// The type role's font, line spacing and letter spacing, scaled with Dynamic Type.
    /// Its Arabic companion when the layout is right to left or the language is written in Arabic script.
    func motifFont(_ type: MotifType) -> some View {
        modifier(MotifFontModifier(type: type))
    }
}

private struct MotifFontModifier: ViewModifier {
    let type: MotifType
    /// The role's size, scaled with Dynamic Type relative to its text style.
    @ScaledMetric private var size: CGFloat
    @Environment(\\.layoutDirection) private var direction
    @Environment(\\.locale) private var locale

    init(type: MotifType) {
        self.type = type
        _size = ScaledMetric(wrappedValue: type.size, relativeTo: type.textStyle)
    }

    func body(content: Content) -> some View {
        let arabic = direction == .rightToLeft || MotifType.isArabic(locale)
        return content
            .font(type.font(size: size, arabic: arabic))
            .lineSpacing(type.lineSpacing(size: size, arabic: arabic))
            .tracking(type.tracking(size: size))
    }
}
"
`;
