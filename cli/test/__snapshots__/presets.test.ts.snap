  --motif-font-body-size: 16px;
  --motif-font-body-weight: 400;
  --motif-font-body-line-height: 1.5;
  --motif-font-label-family: "Public Sans", Mada, "Segoe UI", system-ui, sans-serif;
  --motif-font-label-size: 14px;
  --motif-font-label-weight: 500;
  --motif-font-label-line-height: 1.4;
