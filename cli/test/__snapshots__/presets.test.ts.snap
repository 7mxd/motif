  --motif-font-caption-size: 12px;
  --motif-font-caption-weight: 400;
  --motif-font-caption-line-height: 1.4;
  --motif-font-mono-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  --motif-font-mono-size: 14px;
  --motif-font-mono-weight: 400;
  --motif-font-mono-line-height: 1.5;
  --motif-duration-instant: 0ms;
  --motif-duration-fast: 120ms;
  --motif-duration-base: 200ms;
  --motif-duration-slow: 300ms;
  --motif-easing-standard: cubic-bezier(0.2, 0, 0, 1);
  --motif-easing-enter: cubic-bezier(0, 0, 0, 1);
  --motif-easing-exit: cubic-bezier(0.3, 0, 1, 1);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --motif-color-background: #0C1721;
    --motif-color-surface: #131F2A;
    --motif-color-surface-raised: #1A2834;
    --motif-color-border: #2D3C49;
    --motif-color-text-primary: #E9F0F5;
    --motif-color-text-secondary: #A7B7C3;
    --motif-color-action-primary: #6ABCE6;
    --motif-color-action-secondary: #1C2B37;
    --motif-color-success: #7ED09C;
    --motif-color-warning: #F0C374;
    --motif-color-danger: #F28881;
    --motif-color-info: #80C5C9;
    --motif-color-focus: #6ABCE6;
    --motif-color-brand: #4C7899;
    --motif-color-brand-soft: #1C2B37;
    --motif-color-text-inverse: #0C1721;
    --motif-color-on-action-primary: #10212F;
    --motif-color-on-action-secondary: #FFFFFF;
    --motif-color-on-success: #10212F;
    --motif-color-on-warning: #10212F;
    --motif-color-on-danger: #10212F;
    --motif-color-on-info: #10212F;
    --motif-color-on-brand: #FFFFFF;
  }
}

[data-theme="dark"] {
  color-scheme: dark;
  --motif-color-background: #0C1721;
  --motif-color-surface: #131F2A;
