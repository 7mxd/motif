 * language is written in Arabic script, as MaterialTheme.typography does. Its Latin and Arabic
 * styles choose one font whatever the language.
 */
object MotifType {
    /** In the Arabic companion when the app's language is written in Arabic script. */
    val display: TextStyle
        @Composable
        @ReadOnlyComposable
        get() = if (arabicScript()) displayArabic else displayLatin

    /** In the role's first font, whatever the language. */
    val displayLatin: TextStyle
        get() = TextStyle(
