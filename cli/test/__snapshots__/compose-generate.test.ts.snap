/** Shadows, for Modifier.motifShadow. Inset layers are left out. */
object MotifShadows {
    val sm: List<Shadow> = listOf(
        Shadow(radius = 2.dp, color = Color(0x14000000), offset = DpOffset(0.dp, 1.dp)),
    )
    val md: List<Shadow> = listOf(
        Shadow(radius = 12.dp, color = Color(0x1A000000), offset = DpOffset(0.dp, 4.dp)),
    )
    val lg: List<Shadow> = listOf(
        Shadow(radius = 32.dp, color = Color(0x24000000), offset = DpOffset(0.dp, 12.dp)),
    )
}

/** Draws the layers behind the content in its shape, the first on top as in CSS. */
fun Modifier.motifShadow(shadows: List<Shadow>, shape: Shape): Modifier =
    shadows.foldRight(this) { shadow, modifier -> modifier.dropShadow(shape, shadow) }

/** Durations, in milliseconds. Pass them through MotifMotion.duration for reduced motion. */
object MotifDurations {
    const val instant = 0
    const val fast = 120
    const val base = 200
    const val slow = 320
}

/** Easing curves, for tween(easing = …). */
object MotifEasing {
    val standard = CubicBezierEasing(0.2f, 0f, 0f, 1f)
    val enter = CubicBezierEasing(0f, 0f, 0f, 1f)
    val exit = CubicBezierEasing(0.3f, 0f, 1f, 1f)
}

/** Springs, for animationSpec = MotifSprings.snappy(). */
object MotifSprings {
    fun <T> snappy(): SpringSpec<T> = spring(dampingRatio = 1f, stiffness = 631.65f)
    fun <T> smooth(): SpringSpec<T> = spring(dampingRatio = 0.9f, stiffness = 246.74f)
    fun <T> bouncy(): SpringSpec<T> = spring(dampingRatio = 0.7f, stiffness = 157.91f)
}

/** Reduced motion: when the system turns animations off, durations become zero. */
object MotifMotion {
    /** True when the system asks for less motion (its animator duration scale is 0). */
    @Composable
    fun reduced(): Boolean {
        val scale = Settings.Global.getFloat(
            LocalContext.current.contentResolver,
            Settings.Global.ANIMATOR_DURATION_SCALE,
            1f,
        )
        return scale == 0f
    }

    /** The duration, or zero when the system asks for less motion. */
    @Composable
    fun duration(millis: Int): Int = if (reduced()) 0 else millis
}

