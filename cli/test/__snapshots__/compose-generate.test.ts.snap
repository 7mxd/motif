    val displayArabic: TextStyle
        get() = TextStyle(
            fontFamily = MotifFonts.readexPro,
            fontWeight = FontWeight.W700,
            fontSize = 40.sp,
            lineHeight = 44.sp,
            lineHeightStyle = EvenLeading,
        )

    val title: TextStyle
        get() = TextStyle(
            fontFamily = MotifFonts.inter,
            fontWeight = FontWeight.W700,
            fontSize = 28.sp,
            lineHeight = 33.6.sp,
            lineHeightStyle = EvenLeading,
        )

    val heading: TextStyle
        get() = TextStyle(
            fontFamily = MotifFonts.inter,
            fontWeight = FontWeight.W600,
            fontSize = 20.sp,
            lineHeight = 26.sp,
            lineHeightStyle = EvenLeading,
        )

    /** In the Arabic companion when the app's language is written in Arabic script. */
    val body: TextStyle
        @Composable
        @ReadOnlyComposable
        get() = if (arabicScript()) bodyArabic else bodyLatin

    /** In the role's first font, whatever the language. */
    val bodyLatin: TextStyle
        get() = TextStyle(
            fontFamily = MotifFonts.onest,
            fontWeight = FontWeight.W400,
            fontSize = 16.sp,
            lineHeight = 24.sp,
            lineHeightStyle = EvenLeading,
        )

    /** In the role's Arabic companion, whatever the language. */
    val bodyArabic: TextStyle
        get() = TextStyle(
            fontFamily = MotifFonts.readexPro,
            fontWeight = FontWeight.W400,
            fontSize = 16.sp,
            lineHeight = 24.sp,
            lineHeightStyle = EvenLeading,
        )

    val label: TextStyle
        get() = TextStyle(
            fontFamily = MotifFonts.inter,
            fontWeight = FontWeight.W500,
            fontSize = 14.sp,
            lineHeight = 19.6.sp,
            lineHeightStyle = EvenLeading,
        )

    val caption: TextStyle
        get() = TextStyle(
            fontFamily = MotifFonts.inter,
            fontWeight = FontWeight.W400,
            fontSize = 12.sp,
            lineHeight = 16.8.sp,
            lineHeightStyle = EvenLeading,
        )
}

/** Text sits in the middle of its line height, as on the web. */
private val EvenLeading =
    LineHeightStyle(LineHeightStyle.Alignment.Center, LineHeightStyle.Trim.None)

/** Material's colours, from the guide's roles only: never dynamic colour. */
private fun motifColorScheme(colors: MotifColors, darkTheme: Boolean): ColorScheme =
    if (darkTheme) {
        darkColorScheme(
            primary = colors.actionPrimary,
            onPrimary = colors.onActionPrimary,
            primaryContainer = colors.surfaceRaised,
            onPrimaryContainer = colors.textPrimary,
            inversePrimary = colors.actionPrimary,
            secondary = colors.actionSecondary,
            onSecondary = colors.onActionSecondary,
            secondaryContainer = colors.actionSecondary,
            onSecondaryContainer = colors.onActionSecondary,
            tertiary = colors.actionSecondary,
            onTertiary = colors.onActionSecondary,
            tertiaryContainer = colors.surfaceRaised,
            onTertiaryContainer = colors.textPrimary,
            background = colors.background,
            onBackground = colors.textPrimary,
            surface = colors.surface,
            onSurface = colors.textPrimary,
            surfaceVariant = colors.surfaceRaised,
            onSurfaceVariant = colors.textSecondary,
            surfaceTint = colors.surface,
            inverseSurface = colors.textPrimary,
            inverseOnSurface = colors.textInverse,
            error = colors.danger,
            onError = colors.onDanger,
            errorContainer = colors.danger,
            onErrorContainer = colors.onDanger,
            outline = colors.border,
            outlineVariant = colors.border,
            scrim = Color.Black,
            surfaceBright = colors.surface,
            surfaceDim = colors.background,
            surfaceContainerLowest = colors.background,
            surfaceContainerLow = colors.background,
            surfaceContainer = colors.surface,
            surfaceContainerHigh = colors.surfaceRaised,
            surfaceContainerHighest = colors.surfaceRaised,
        )
    } else {
        lightColorScheme(
            primary = colors.actionPrimary,
            onPrimary = colors.onActionPrimary,
            primaryContainer = colors.surfaceRaised,
            onPrimaryContainer = colors.textPrimary,
            inversePrimary = colors.actionPrimary,
            secondary = colors.actionSecondary,
            onSecondary = colors.onActionSecondary,
            secondaryContainer = colors.actionSecondary,
            onSecondaryContainer = colors.onActionSecondary,
            tertiary = colors.actionSecondary,
            onTertiary = colors.onActionSecondary,
            tertiaryContainer = colors.surfaceRaised,
            onTertiaryContainer = colors.textPrimary,
            background = colors.background,
            onBackground = colors.textPrimary,
            surface = colors.surface,
            onSurface = colors.textPrimary,
            surfaceVariant = colors.surfaceRaised,
            onSurfaceVariant = colors.textSecondary,
            surfaceTint = colors.surface,
            inverseSurface = colors.textPrimary,
            inverseOnSurface = colors.textInverse,
            error = colors.danger,
            onError = colors.onDanger,
            errorContainer = colors.danger,
            onErrorContainer = colors.onDanger,
            outline = colors.border,
            outlineVariant = colors.border,
            scrim = Color.Black,
            surfaceBright = colors.surface,
            surfaceDim = colors.background,
            surfaceContainerLowest = colors.background,
            surfaceContainerLow = colors.background,
            surfaceContainer = colors.surface,
            surfaceContainerHigh = colors.surfaceRaised,
            surfaceContainerHighest = colors.surfaceRaised,
        )
    }

/** Material's type scale on the guide's roles: each slot steps down on the guide's own sizes. */
@Composable
@ReadOnlyComposable
private fun motifTypography(): Typography {
    val display = MotifType.display
    val title = MotifType.title
    val heading = MotifType.heading
    val body = MotifType.body
    val caption = MotifType.caption
    val label = MotifType.label
    return Typography(
        displayLarge = display,
        displayMedium = display,
        displaySmall = display,
        headlineLarge = title,
        headlineMedium = title,
        headlineSmall = title.copy(fontSize = 20.sp, lineHeight = 24.sp),
        titleLarge = heading,
        titleMedium = heading.copy(fontSize = 16.sp, lineHeight = 20.8.sp),
        titleSmall = heading.copy(fontSize = 14.sp, lineHeight = 18.2.sp),
        bodyLarge = body,
        bodyMedium = body.copy(fontSize = 14.sp, lineHeight = 21.sp),
        bodySmall = caption,
        labelLarge = label,
        labelMedium = label.copy(fontSize = 12.sp, lineHeight = 16.8.sp),
        labelSmall = label.copy(fontSize = 12.sp, lineHeight = 16.8.sp),
    )
}

/** Material's corners, from the guide's radii. */
private val MotifShapes = Shapes(
    extraSmall = RoundedCornerShape(MotifRadius.sm),
    small = RoundedCornerShape(MotifRadius.sm),
    medium = RoundedCornerShape(MotifRadius.md),
    large = RoundedCornerShape(MotifRadius.lg),
    extraLarge = RoundedCornerShape(MotifRadius.lg),
)

/** Languages written in Arabic script: their text takes the type roles' Arabic companion. */
private val ARABIC_SCRIPT = setOf("ar", "fa", "ur", "ps", "ckb", "sd", "ug")

/** True when the app's language (in a preview, the one it sets) is written in Arabic script. */
@Composable
@ReadOnlyComposable
private fun arabicScript(): Boolean {
    val configuration = LocalConfiguration.current
    val language = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
        configuration.locales[0].language
    } else {
        @Suppress("DEPRECATION")
        configuration.locale.language
    }
    return language in ARABIC_SCRIPT
}

/**
 * The guide's Material theme: its colours (light or dark), type and corners, and MotifTheme.colors
 * for every colour role.
 *
 * In a language written in Arabic script, the type roles use their Arabic companion.
 */
@Composable
fun MotifTheme(
    darkTheme: Boolean = isSystemInDarkTheme(),
    content: @Composable () -> Unit,
) {
    val colors = if (darkTheme) MotifColors.Dark else MotifColors.Light
    CompositionLocalProvider(LocalMotifColors provides colors) {
        MaterialTheme(
            colorScheme = motifColorScheme(colors, darkTheme),
            typography = motifTypography(),
            shapes = MotifShapes,
            content = content,
        )
    }
}

/** The theme's values in a composable: MotifTheme.colors.textSecondary. */
object MotifTheme {
    /** The colour roles of the nearest MotifTheme. */
    val colors: MotifColors
        @Composable
        @ReadOnlyComposable
        get() = LocalMotifColors.current
}
"
`;
