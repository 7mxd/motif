"// Generated by Motif — edit design/tokens.json instead, then run "motif tokens".

import { createContext, useContext, useMemo, type ReactNode } from "react";
import { useColorScheme, type TextStyle } from "react-native";
import { Easing, useReducedMotion } from "react-native-reanimated";
import { Inter_400Regular, Inter_500Medium, Inter_600SemiBold, Inter_700Bold } from "@expo-google-fonts/inter";

/** The guide's colour roles. */
export type MotifColors = {
  background: string;
  surface: string;
  surfaceRaised: string;
  border: string;
  textPrimary: string;
  textSecondary: string;
  textInverse: string;
  actionPrimary: string;
  onActionPrimary: string;
  actionSecondary: string;
  onActionSecondary: string;
  focus: string;
  success: string;
  onSuccess: string;
  warning: string;
  onWarning: string;
  danger: string;
  onDanger: string;
  info: string;
  onInfo: string;
};

/** The colours, light and dark. */
export const motifColors: { light: MotifColors; dark: MotifColors } = {
  light: {
    background: "#f9fafb",
    surface: "#ffffff",
    surfaceRaised: "#ffffff",
    border: "#d1d5db",
    textPrimary: "#111827",
    textSecondary: "#4b5563",
    textInverse: "#ffffff",
    actionPrimary: "#4338ca",
    onActionPrimary: "#ffffff",
    actionSecondary: "#e5e7eb",
    onActionSecondary: "#111827",
    focus: "#4338ca",
    success: "#15803d",
    onSuccess: "#ffffff",
    warning: "#b45309",
    onWarning: "#ffffff",
    danger: "#b91c1c",
    onDanger: "#ffffff",
    info: "#1d4ed8",
    onInfo: "#ffffff",
  },
  dark: {
    background: "#030712",
    surface: "#111827",
    surfaceRaised: "#1f2937",
    border: "#374151",
    textPrimary: "#f9fafb",
    textSecondary: "#9ca3af",
    textInverse: "#111827",
    actionPrimary: "#818cf8",
    onActionPrimary: "#111827",
    actionSecondary: "#374151",
    onActionSecondary: "#f9fafb",
    focus: "#818cf8",
    success: "#4ade80",
    onSuccess: "#111827",
    warning: "#fbbf24",
    onWarning: "#111827",
    danger: "#f87171",
    onDanger: "#111827",
    info: "#60a5fa",
    onInfo: "#111827",
  },
};

/** Spacing, in pixels. */
export const space = {
  s0: 0,
  s1: 4,
  s2: 8,
  s3: 12,
  s4: 16,
  s5: 20,
  s6: 24,
  s8: 32,
  s10: 40,
  s12: 48,
  s16: 64,
} as const;

/** Corner radii, in pixels. */
export const radius = {
  none: 0,
  sm: 4,
  md: 8,
  lg: 16,
  full: 9999,
} as const;

/** Shadows, for a style's boxShadow (React Native 0.76 and later, on the New Architecture). */
export const shadow = {
  sm: { boxShadow: "0px 1px 2px rgba(0, 0, 0, 0.08)" },
  md: { boxShadow: "0px 4px 12px rgba(0, 0, 0, 0.1)" },
  lg: { boxShadow: "0px 12px 32px rgba(0, 0, 0, 0.14)" },
};

/** Durations, in milliseconds. */
export const duration = {
  instant: 0,
  fast: 120,
  base: 200,
  slow: 320,
};

/** Easing curves, for Reanimated's withTiming. */
export const easing = {
  standard: Easing.bezier(0.2, 0, 0, 1),
  enter: Easing.bezier(0, 0, 0, 1),
  exit: Easing.bezier(0.3, 0, 1, 1),
};

/** Springs, for Reanimated's withSpring. */
export const spring = {
  snappy: { mass: 1, stiffness: 631.65, damping: 50.27 },
  smooth: { mass: 1, stiffness: 246.74, damping: 28.27 },
  bouncy: { mass: 1, stiffness: 157.91, damping: 17.59 },
};

/** One of the guide's type roles, as a style's text properties. */
export type MotifTextStyle = Pick<TextStyle, "fontFamily" | "fontSize" | "lineHeight" | "fontWeight" | "letterSpacing">;
export type MotifTypeRole = "display" | "title" | "heading" | "body" | "label" | "caption";

// A loaded font face is its own family on React Native, so a role names the face for its weight
// (Onest_600SemiBold) and carries no fontWeight, because a fontWeight on top makes Android fall back to a system font.
// A role whose font isn't loaded uses the system font, with its fontWeight.
export const type: Record<MotifTypeRole, MotifTextStyle> = {
  display: { fontFamily: "Inter_700Bold", fontSize: 40, lineHeight: 44 },
  title: { fontFamily: "Inter_700Bold", fontSize: 28, lineHeight: 33.6 },
  heading: { fontFamily: "Inter_600SemiBold", fontSize: 20, lineHeight: 26 },
  body: { fontFamily: "Inter_400Regular", fontSize: 16, lineHeight: 24 },
  label: { fontFamily: "Inter_500Medium", fontSize: 14, lineHeight: 19.6 },
  caption: { fontFamily: "Inter_400Regular", fontSize: 12, lineHeight: 16.8 },
};

/** The fonts to load before the first screen: useFonts(motifFonts) from expo-font. */
export const motifFonts: Record<string, number | string> = {
  Inter_400Regular,
  Inter_500Medium,
  Inter_600SemiBold,
  Inter_700Bold,
};

export type MotifThemeValue = {
  colors: MotifColors;
  type: typeof type;
  dark: boolean;
  reducedMotion: boolean;
};

const MotifContext = createContext<MotifThemeValue | null>(null);

export function MotifProvider({ children }: { children: ReactNode }) {
  const dark = useColorScheme() === "dark";
  const reducedMotion = useReducedMotion();
  const value = useMemo<MotifThemeValue>(
    () => ({
      colors: motifColors[dark ? "dark" : "light"],
      type: type,
      dark,
      reducedMotion,
    }),
    [dark, reducedMotion],
  );
  return <MotifContext.Provider value={value}>{children}</MotifContext.Provider>;
}

/** The colours, type and settings for the current scheme, variant and language. */
export function useMotifTheme(): MotifThemeValue {
  const value = useContext(MotifContext);
  if (value === null) {
    throw new Error("useMotifTheme needs <MotifProvider> above it. Wrap your root layout in <MotifProvider>.");
  }
  return value;
}
"
