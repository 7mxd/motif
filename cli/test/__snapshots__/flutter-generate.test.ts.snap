"// Generated by Motif — edit design/tokens.json instead, then run "motif tokens".

import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';

/// The guide's colour roles, light and dark.
///
/// Read them in a widget with MotifColors.of(context).
class MotifColors extends ThemeExtension<MotifColors> {
  const MotifColors({
    required this.background,
    required this.surface,
    required this.surfaceRaised,
    required this.border,
    required this.textPrimary,
    required this.textSecondary,
    required this.textInverse,
    required this.actionPrimary,
    required this.onActionPrimary,
    required this.actionSecondary,
    required this.onActionSecondary,
    required this.focus,
    required this.success,
    required this.onSuccess,
    required this.warning,
    required this.onWarning,
    required this.danger,
    required this.onDanger,
    required this.info,
    required this.onInfo,
  });

  final Color background;
  final Color surface;
  final Color surfaceRaised;
  final Color border;
  final Color textPrimary;
  final Color textSecondary;
  final Color textInverse;
  final Color actionPrimary;
  final Color onActionPrimary;
  final Color actionSecondary;
  final Color onActionSecondary;
  final Color focus;
  final Color success;
  final Color onSuccess;
  final Color warning;
  final Color onWarning;
  final Color danger;
  final Color onDanger;
  final Color info;
  final Color onInfo;

  /// Light mode.
  static const MotifColors light = MotifColors(
    background: Color(0xFFF9FAFB),
    surface: Color(0xFFFFFFFF),
    surfaceRaised: Color(0xFFFFFFFF),
    border: Color(0xFFD1D5DB),
    textPrimary: Color(0xFF111827),
    textSecondary: Color(0xFF4B5563),
    textInverse: Color(0xFFFFFFFF),
    actionPrimary: Color(0xFF4338CA),
    onActionPrimary: Color(0xFFFFFFFF),
    actionSecondary: Color(0xFFE5E7EB),
    onActionSecondary: Color(0xFF111827),
    focus: Color(0xFF4338CA),
    success: Color(0xFF15803D),
    onSuccess: Color(0xFFFFFFFF),
    warning: Color(0xFFB45309),
    onWarning: Color(0xFFFFFFFF),
    danger: Color(0xFFB91C1C),
    onDanger: Color(0xFFFFFFFF),
    info: Color(0xFF1D4ED8),
    onInfo: Color(0xFFFFFFFF),
  );

  /// Dark mode.
  static const MotifColors dark = MotifColors(
    background: Color(0xFF030712),
    surface: Color(0xFF111827),
    surfaceRaised: Color(0xFF1F2937),
    border: Color(0xFF374151),
    textPrimary: Color(0xFFF9FAFB),
    textSecondary: Color(0xFF9CA3AF),
    textInverse: Color(0xFF111827),
    actionPrimary: Color(0xFF818CF8),
    onActionPrimary: Color(0xFF111827),
    actionSecondary: Color(0xFF374151),
    onActionSecondary: Color(0xFFF9FAFB),
    focus: Color(0xFF818CF8),
    success: Color(0xFF4ADE80),
    onSuccess: Color(0xFF111827),
    warning: Color(0xFFFBBF24),
    onWarning: Color(0xFF111827),
    danger: Color(0xFFF87171),
    onDanger: Color(0xFF111827),
    info: Color(0xFF60A5FA),
    onInfo: Color(0xFF111827),
  );

  /// The nearest theme's colours, or the default ones for its brightness.
  static MotifColors of(BuildContext context) {
    final theme = Theme.of(context);
    return theme.extension<MotifColors>() ??
        (theme.brightness == Brightness.dark ? dark : light);
  }

  @override
  MotifColors copyWith({
    Color? background,
    Color? surface,
    Color? surfaceRaised,
    Color? border,
    Color? textPrimary,
    Color? textSecondary,
    Color? textInverse,
    Color? actionPrimary,
    Color? onActionPrimary,
    Color? actionSecondary,
    Color? onActionSecondary,
    Color? focus,
    Color? success,
    Color? onSuccess,
    Color? warning,
    Color? onWarning,
    Color? danger,
    Color? onDanger,
    Color? info,
    Color? onInfo,
  }) {
    return MotifColors(
      background: background ?? this.background,
      surface: surface ?? this.surface,
      surfaceRaised: surfaceRaised ?? this.surfaceRaised,
      border: border ?? this.border,
      textPrimary: textPrimary ?? this.textPrimary,
      textSecondary: textSecondary ?? this.textSecondary,
      textInverse: textInverse ?? this.textInverse,
      actionPrimary: actionPrimary ?? this.actionPrimary,
      onActionPrimary: onActionPrimary ?? this.onActionPrimary,
      actionSecondary: actionSecondary ?? this.actionSecondary,
      onActionSecondary: onActionSecondary ?? this.onActionSecondary,
      focus: focus ?? this.focus,
      success: success ?? this.success,
      onSuccess: onSuccess ?? this.onSuccess,
      warning: warning ?? this.warning,
      onWarning: onWarning ?? this.onWarning,
      danger: danger ?? this.danger,
      onDanger: onDanger ?? this.onDanger,
      info: info ?? this.info,
      onInfo: onInfo ?? this.onInfo,
    );
  }

  @override
  MotifColors lerp(MotifColors? other, double t) {
    if (other == null) return this;
    return MotifColors(
      background: Color.lerp(background, other.background, t)!,
      surface: Color.lerp(surface, other.surface, t)!,
      surfaceRaised: Color.lerp(surfaceRaised, other.surfaceRaised, t)!,
      border: Color.lerp(border, other.border, t)!,
      textPrimary: Color.lerp(textPrimary, other.textPrimary, t)!,
      textSecondary: Color.lerp(textSecondary, other.textSecondary, t)!,
      textInverse: Color.lerp(textInverse, other.textInverse, t)!,
      actionPrimary: Color.lerp(actionPrimary, other.actionPrimary, t)!,
      onActionPrimary: Color.lerp(onActionPrimary, other.onActionPrimary, t)!,
      actionSecondary: Color.lerp(actionSecondary, other.actionSecondary, t)!,
      onActionSecondary: Color.lerp(
        onActionSecondary,
        other.onActionSecondary,
        t,
      )!,
      focus: Color.lerp(focus, other.focus, t)!,
      success: Color.lerp(success, other.success, t)!,
      onSuccess: Color.lerp(onSuccess, other.onSuccess, t)!,
      warning: Color.lerp(warning, other.warning, t)!,
      onWarning: Color.lerp(onWarning, other.onWarning, t)!,
      danger: Color.lerp(danger, other.danger, t)!,
      onDanger: Color.lerp(onDanger, other.onDanger, t)!,
      info: Color.lerp(info, other.info, t)!,
      onInfo: Color.lerp(onInfo, other.onInfo, t)!,
    );
  }
}

/// Spacing, in logical pixels.
abstract final class MotifSpace {
  static const double s0 = 0;
  static const double s1 = 4;
  static const double s2 = 8;
  static const double s3 = 12;
  static const double s4 = 16;
  static const double s5 = 20;
  static const double s6 = 24;
  static const double s8 = 32;
  static const double s10 = 40;
  static const double s12 = 48;
  static const double s16 = 64;
}

/// Corner radii, in logical pixels.
abstract final class MotifRadius {
  static const double none = 0;
  static const double sm = 4;
  static const double md = 8;
  static const double lg = 16;
  static const double full = 9999;
}

/// Shadows, for BoxDecoration.boxShadow.
abstract final class MotifShadows {
  static const List<BoxShadow> sm = [
    BoxShadow(color: Color(0x14000000), offset: Offset(0, 1), blurRadius: 2),
  ];
  static const List<BoxShadow> md = [
    BoxShadow(color: Color(0x1A000000), offset: Offset(0, 4), blurRadius: 12),
  ];
  static const List<BoxShadow> lg = [
    BoxShadow(color: Color(0x24000000), offset: Offset(0, 12), blurRadius: 32),
  ];
}

/// Durations. Pass them through MotifMotion.duration for reduced motion.
abstract final class MotifDurations {
  static const Duration instant = Duration(milliseconds: 0);
  static const Duration fast = Duration(milliseconds: 120);
  static const Duration base = Duration(milliseconds: 200);
  static const Duration slow = Duration(milliseconds: 320);
}

/// Easing curves.
abstract final class MotifCurves {
  static const Cubic standard = Cubic(0.2, 0, 0, 1);
  static const Cubic enter = Cubic(0, 0, 0, 1);
  static const Cubic exit = Cubic(0.3, 0, 1, 1);
}

/// Springs, for SpringSimulation.
abstract final class MotifSprings {
  static final SpringDescription snappy = SpringDescription(
    mass: 1,
    stiffness: 631.65,
    damping: 50.27,
  );
  static final SpringDescription smooth = SpringDescription(
    mass: 1,
    stiffness: 246.74,
    damping: 28.27,
  );
  static final SpringDescription bouncy = SpringDescription(
    mass: 1,
    stiffness: 157.91,
    damping: 17.59,
  );
}

/// Reduced motion: when the system asks for less, durations become zero.
abstract final class MotifMotion {
  /// True when the system asks for less motion.
  static bool reduced(BuildContext context) =>
      MediaQuery.disableAnimationsOf(context);

  /// The duration, or zero when the system asks for less motion.
  static Duration duration(BuildContext context, Duration value) =>
      reduced(context) ? Duration.zero : value;
}

/// The guide's type roles: size, weight, line height and letter spacing.
/// They carry no colour, so the theme's text colour applies.
abstract final class MotifText {
  static TextStyle get display => _font(
    'Inter',
    const TextStyle(
      fontSize: 40,
      fontWeight: FontWeight.w700,
      height: 1.1,
      leadingDistribution: TextLeadingDistribution.even,
    ),
  );

  static TextStyle get title => _font(
    'Inter',
    const TextStyle(
      fontSize: 28,
      fontWeight: FontWeight.w700,
      height: 1.2,
      leadingDistribution: TextLeadingDistribution.even,
    ),
  );

  static TextStyle get heading => _font(
    'Inter',
    const TextStyle(
      fontSize: 20,
      fontWeight: FontWeight.w600,
      height: 1.3,
      leadingDistribution: TextLeadingDistribution.even,
    ),
  );

  static TextStyle get body => _font(
    'Inter',
    const TextStyle(
      fontSize: 16,
      fontWeight: FontWeight.w400,
      height: 1.5,
      leadingDistribution: TextLeadingDistribution.even,
    ),
  );

  static TextStyle get label => _font(
    'Inter',
    const TextStyle(
      fontSize: 14,
      fontWeight: FontWeight.w500,
      height: 1.4,
      leadingDistribution: TextLeadingDistribution.even,
    ),
  );

  static TextStyle get caption => _font(
    'Inter',
    const TextStyle(
      fontSize: 12,
      fontWeight: FontWeight.w400,
      height: 1.4,
      leadingDistribution: TextLeadingDistribution.even,
    ),
  );

  /// The family through google_fonts, which loads it, or by its plain name
  /// when google_fonts doesn't have it (a font the app bundles itself).
  static TextStyle _font(
    String family,
    TextStyle style, [
    List<String>? fallback,
  ]) {
    final font = GoogleFonts.asMap().containsKey(family)
        ? GoogleFonts.getFont(family, textStyle: style)
        : style.copyWith(fontFamily: family);
    return fallback == null
        ? font
        : font.copyWith(fontFamilyFallback: fallback);
  }
}

/// Material themes built from the guide, for your MaterialApp:
/// theme: MotifTheme.light(), darkTheme: MotifTheme.dark().
abstract final class MotifTheme {
  /// The light theme.
  static ThemeData light() => _theme(Brightness.light, MotifColors.light);

  /// The dark theme.
  static ThemeData dark() => _theme(Brightness.dark, MotifColors.dark);

  static ThemeData _theme(Brightness brightness, MotifColors colors) {
    return ThemeData(
      useMaterial3: true,
      colorScheme: ColorScheme(
        brightness: brightness,
        primary: colors.actionPrimary,
        onPrimary: colors.onActionPrimary,
        secondary: colors.actionSecondary,
        onSecondary: colors.onActionSecondary,
        error: colors.danger,
        onError: colors.onDanger,
        surface: colors.surface,
        onSurface: colors.textPrimary,
        onSurfaceVariant: colors.textSecondary,
        surfaceContainerLow: colors.background,
        surfaceContainer: colors.surface,
        surfaceContainerHigh: colors.surfaceRaised,
        surfaceContainerHighest: colors.surfaceRaised,
        outline: colors.border,
        outlineVariant: colors.border,
        inverseSurface: colors.textPrimary,
        onInverseSurface: colors.textInverse,
        surfaceTint: colors.surface,
      ),
      scaffoldBackgroundColor: colors.background,
      dividerColor: colors.border,
      textTheme: TextTheme(
        displayLarge: MotifText.display,
        displayMedium: MotifText.display,
        displaySmall: MotifText.display,
        headlineLarge: MotifText.title,
        headlineMedium: MotifText.title,
        headlineSmall: MotifText.title,
        titleLarge: MotifText.heading,
        titleMedium: MotifText.heading,
        titleSmall: MotifText.heading,
        bodyLarge: MotifText.body,
        bodyMedium: MotifText.body,
        bodySmall: MotifText.caption,
        labelLarge: MotifText.label,
        labelMedium: MotifText.label,
        labelSmall: MotifText.caption,
      ),
      extensions: [colors],
    );
  }
}
"
