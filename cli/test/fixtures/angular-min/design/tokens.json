  "color": {
    "$type": "color",
    "background": {
      "$value": "{primitive.color.gray.50}",
      "$extensions": {
        "dev.motif": {
          "modes": {
            "dark": "{primitive.color.gray.950}"
          },
          "variants": {
            "partner": {
              "value": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  0.9294,
                  0.8353
                ],
                "hex": "#FFEDD5"
              },
              "dark": {
                "colorSpace": "srgb",
                "components": [
                  0.0471,
                  0.0392,
                  0.0353
                ],
                "hex": "#0C0A09"
              }
            }
          }
        }
      }
    },
    "surface": {
      "$value": "{primitive.color.white}",
      "$extensions": {
        "dev.motif": {
          "modes": {
            "dark": "{primitive.color.gray.900}"
          },
          "variants": {
            "partner": {
              "value": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  0.9686,
                  0.9294
