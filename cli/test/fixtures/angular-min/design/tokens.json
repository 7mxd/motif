  "duration": {
    "$type": "duration",
    "instant": {
      "$value": {
        "value": 0,
        "unit": "ms"
      }
    },
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 320,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0,
        1
      ]
    },
    "exit": {
      "$value": [
        0.3,
        0,
        1,
        1
      ]
    }
  },
  "spring": {
    "snappy": {
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 0.25,
          "unit": "s"
        }
      },
      "bounce": {
        "$type": "number",
        "$value": 0
      }
    },
    "smooth": {
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 0.4,
          "unit": "s"
        }
      },
      "bounce": {
        "$type": "number",
        "$value": 0.1
      }
    },
    "bouncy": {
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 0.5,
          "unit": "s"
        }
      },
      "bounce": {
        "$type": "number",
        "$value": 0.3
      }
    }
  }
