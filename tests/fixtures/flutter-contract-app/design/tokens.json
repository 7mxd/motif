        {
          "fg": "color.on-info",
          "bg": "color.info",
          "kind": "text"
        },
        {
          "fg": "color.focus",
          "bg": "color.background",
          "kind": "ui"
        }
      ],
      "variants": [
        {
          "id": "default",
          "label": "Default",
          "default": true
        },
        {
          "id": "kids",
          "label": "Kids' corner"
        }
      ]
    }
  },
