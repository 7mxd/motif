  "color": {
    "$type": "color",
    "background": {
      "$value": "{primitive.color.light-background}",
      "$extensions": {
        "dev.motif": {
          "modes": {
            "dark": "{primitive.color.dark-background}"
          },
          "variants": {
            "workshop": {
              "value": "{primitive.color.workshop-background}",
              "dark": "{primitive.color.workshop-background-dark}"
